#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) != Linux ]]; then
    echo 'adofox requires Linux with X11 or Xwayland.' >&2
    exit 1
fi
if [[ -z ${DISPLAY:-} ]]; then
    echo 'DISPLAY is not set; start an X11 or Xwayland session.' >&2
    exit 1
fi
for tool in docker xauth; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Missing required command: $tool" >&2
        exit 1
    fi
done

base="${HOME}/.adofox"
share="${HOME}/adofox-share"
mkdir -p "$base" "$share"
auth_dir=$(mktemp -d)
trap 'rm -rf -- "$auth_dir"' EXIT
chmod 700 "$auth_dir"
auth_file="$auth_dir/xauth"
touch "$auth_file"
chmod 600 "$auth_file"

# Wildcard the Xauthority family: the hostname changes inside the container.
host_auth="${XAUTHORITY:-${HOME}/.Xauthority}"
if [[ ! -r $host_auth ]] || ! xauth -f "$host_auth" nlist "$DISPLAY" | sed 's/^..../ffff/' | xauth -f "$auth_file" nmerge - || [[ -z $(xauth -f "$auth_file" list) ]]; then
    echo "No X11 authorization for DISPLAY=$DISPLAY in $host_auth" >&2
    exit 1
fi

args=(--rm --init --shm-size=1g
    --user "$(id -u):$(id -g)"
    -e HOME=/home/ffuser
    -e "DISPLAY=$DISPLAY"
    -e XAUTHORITY=/tmp/adofox-xauth/xauth
    -v /tmp/.X11-unix:/tmp/.X11-unix:ro
    -v "$auth_dir:/tmp/adofox-xauth:ro"
    -v "$share:/home/adofox:ro"
    -v "$base:/home/ffuser")
if [[ -t 0 && -t 1 ]]; then
    args+=(-it)
fi

docker run "${args[@]}" adofox "$@"
